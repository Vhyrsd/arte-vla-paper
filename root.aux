\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Comparison of action-generation paradigms. (a) Direct VLA policies map multimodal context to an action chunk without an explicit prediction of scene evolution. (b) A world action model~\cite  {wang2026world} predicts high-dimensional visual futures before action generation. (c) ArTE-VLA{} instead infers an implicit language-grounded target and predicts a compact chain of structured target effects that conditions the action expert.}}{1}{}\protected@file@percent }
\newlabel{fig:teaser}{{1}{1}{}{figure.1}{}}
