\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Workspace-view projection of four-horizon implicit target effects for one Butter training state. The first row shows simulator teacher effects and the second row shows model predictions. Colored arrows represent target displacement, dashed arrows represent future linear velocity, and short dark segments indicate the projected target $x$-axis. The current target pose and camera calibration are used only for visualization projection and are not model inputs.}}{7}{}\protected@file@percent }
\newlabel{fig:effect_agentview}{{3}{7}{}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Implicit target-effect signatures for the state in Fig.~\ref {fig:effect_agentview}. Rows denote the four future horizons, and columns encode translation, rotation, linear velocity, angular velocity, and activity. Continuous teacher and prediction channels use shared group-wise scales; the activity column shows the binary teacher label or predicted probability. Future-effect labels are used only to form the teacher and error panels and are not provided to the prediction path.}}{7}{}\protected@file@percent }
\newlabel{fig:effect_signature}{{4}{7}{}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Spatial occlusion sensitivity of the implicit target-effect prediction for the state in Figs.~\ref {fig:effect_agentview} and~\ref {fig:effect_signature}. Each heatmap reports the RMS change, in millimeters, of the predicted four-horizon target translation chain after independently occluding an $8\times 8$ grid cell. Both views share the same color scale; warmer regions have greater influence on the prediction. No teacher effect, target position, segmentation, or simulator state is used to compute the sensitivity.}}{7}{}\protected@file@percent }
\newlabel{fig:effect_spatial}{{5}{7}{}{figure.5}{}}
